# FurnaceGuard AI — contoh konfigurasi lingkungan
# Salin ke .env dan sesuaikan. JANGAN commit .env (README §21).

# Lokasi data mentah pembangkit (read-only)
FG_RAW_DATA_DIR=./data

# Lokasi konfigurasi YAML
FG_CONFIG_DIR=./config

# Lokasi keluaran
FG_DATASETS_DIR=./backend/datasets
FG_MODELS_DIR=./backend/models
FG_REPORTS_DIR=./backend/reports

# Seed generator sintetis — tetapkan agar hasil dapat diulang
FG_SYNTHETIC_SEED=20260726

# Level log: DEBUG | INFO | WARNING | ERROR
FG_LOG_LEVEL=INFO

# Zona waktu operasi (README §1)
FG_TIMEZONE=Asia/Makassar

# Mode deployment: offline | shadow | advisory (README §19)
# Fase 0 wajib "offline" — tidak ada koneksi ke historian/DCS.
FG_DEPLOYMENT_MODE=offline
